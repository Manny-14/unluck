datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  identities  Identity[]
  habits      Habit[]
  tasks       Task[]
  bundleRules BundleRule[]
}

model Identity {
  id        String   @id @default(uuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits    Habit[]
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Habit {
  id             String     @id @default(uuid())
  title          String
  description    String?
  isArchived     Boolean    @default(false)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityId     String?
  identity       Identity?  @relation(fields: [identityId], references: [id], onDelete: SetNull)
  tasks          Task[]     @relation("HabitTask")
  
  // Blueprint for generated tasks
  timeOfDay      String?    // E.g., "08:00"
  location       String?    // E.g., "At my desk"
  temptationWant String?    // If this is a temptation bundle
  
  // Comma-separated string of days (0=Sunday, 6=Saturday). Default is daily.
  recurrenceDays String     @default("0,1,2,3,4,5,6") 
  
  createdAt      DateTime   @default(now())
}

model Task {
  id             String    @id @default(uuid())
  title          String
  note           String?
  dueDate        DateTime?
  completedAt    DateTime?
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityId     String?
  identity       Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  
  // Habit Link (Indicates this task was generated by a Habit)
  habitId        String?
  habit          Habit?    @relation("HabitTask", fields: [habitId], references: [id], onDelete: SetNull)
  
  // Implementation Intentions
  timeOfDay      String?
  location       String?
  
  temptationWant String?
  createdAt      DateTime  @default(now())
}

model BundleRule {
  id        String   @id @default(uuid())
  needText  String
  wantText  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
